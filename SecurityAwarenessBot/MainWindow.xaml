<Window x:Class="SecurityAwarenessBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manuel Security Services MSS — Cybersecurity Awareness Bot"
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI, Roboto, Helvetica, Arial, sans-serif">

    <Window.Resources>
        <!-- Custom ScrollBar Styling for sleek modern dark look -->
        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- Glassmorphic Button Template -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#00D2FF"/>
            <Setter Property="BorderBrush" Value="#333337"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00D2FF"/>
                    <Setter Property="Foreground" Value="#121212"/>
                    <Setter Property="BorderBrush" Value="#00B4DB"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0099B8"/>
                    <Setter Property="BorderBrush" Value="#00809A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Action Button (Send) -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#00E676"/>
            <Setter Property="Foreground" Value="#121212"/>
            <Setter Property="BorderBrush" Value="#00C853"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FF9E"/>
                    <Setter Property="Foreground" Value="#121212"/>
                    <Setter Property="BorderBrush" Value="#00E676"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- MAIN APP LAYER -->
        <Grid x:Name="MainAppGrid" Background="#141414" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- SUB-HEADER PANEL (MINI ASCII LOGO ON TOP LEFT) -->
            <Border Grid.Row="0" Background="#1E1E1E" Padding="20,8" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Top Left: Mini ASCII Art Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Border Background="#121212" CornerRadius="4" Padding="8,4" BorderBrush="#2D2D2D" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock FontFamily="Consolas, Monospace" FontSize="7.5" FontWeight="Bold" Foreground="#00D2FF" LineHeight="8" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center">
                                ███╗   ███╗ ███████╗ ███████╗<LineBreak/>
                                ████╗ ████║ ██╔════╝ ██╔════╝<LineBreak/>
                                ██╔████╔██║ ███████╗ ███████╗<LineBreak/>
                                ██║╚██╔╝██║ ╚════██║ ╚════██║<LineBreak/>
                                ██║ ╚═╝ ██║ ███████║ ███████║<LineBreak/>
                                ╚═╝     ╚═╝ ╚══════╝ ╚══════╝
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Top Right: User Profile and controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#252526" CornerRadius="4" Padding="8,4" BorderBrush="#2D2D2D" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock x:Name="TxtHeaderUser" Text="👤 Guest" FontSize="12" FontWeight="SemiBold" Foreground="#00E676" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Mini Header Navigation -->
                        <Button Content="HELP MENU" Style="{StaticResource ModernButton}" Padding="8,3" FontSize="11" Click="BtnHelp_Click" Margin="0,0,5,0"/>
                        <Button Content="EXIT SESSION" Style="{StaticResource ModernButton}" Padding="8,3" FontSize="11" Click="BtnExit_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MESSAGE LOG CONTAINER -->
            <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" Padding="20,15" ScrollChanged="ChatScrollViewer_ScrollChanged">
                <StackPanel x:Name="ChatPanel" Orientation="Vertical" Margin="0,0,0,20"/>
            </ScrollViewer>

            <!-- BOTTOM CHAT INPUT PANEL -->
            <Border Grid.Row="2" Background="#1E1E1E" Padding="20,15" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <!-- Input TextBox -->
                    <Border Grid.Column="0" Background="#121212" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="6" Padding="10,2">
                        <TextBox x:Name="TxtChatInput"
                                 Background="Transparent"
                                 Foreground="#E0E0E0"
                                 BorderThickness="0"
                                 CaretBrush="#00D2FF"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 GotFocus="TxtChatInput_GotFocus"
                                 LostFocus="TxtChatInput_LostFocus"
                                 KeyDown="TxtChatInput_KeyDown"/>
                    </Border>

                    <!-- Send Button -->
                    <Button Grid.Column="1"
                            x:Name="BtnSend"
                            Content="SEND"
                            Style="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0"
                            Height="40"
                            Click="BtnSend_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- OVERLAY: USER ONBOARDING POPUP -->
        <Grid x:Name="OnboardingGrid" Background="#D8000000" Visibility="Visible">
            <Border Background="#1E1E1E" Width="440" Height="340" CornerRadius="12" BorderBrush="#2D2D2D" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Margin="25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Full-Size Center ASCII Art Logo -->
                    <Border Grid.Row="0" Background="#121212" CornerRadius="8" Padding="15,10" BorderBrush="#2D2D2D" BorderThickness="1" Margin="0,0,0,10" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Consolas, Monospace" FontSize="11" Foreground="#00D2FF" TextAlignment="Center" LineHeight="12">
                            ███╗   ███╗ ███████╗ ███████╗<LineBreak/>
                            ████╗ ████║ ██╔════╝ ██╔════╝<LineBreak/>
                            ██╔████╔██║ ███████╗ ███████╗<LineBreak/>
                            ██║╚██╔╝██║ ╚════██║ ╚════██║<LineBreak/>
                            ██║ ╚═╝ ██║ ███████║ ███████║<LineBreak/>
                            ╚═╝     ╚═╝ ╚══════╝ ╚══════╝<LineBreak/>
                            <Span Foreground="Yellow" FontSize="8">PROFESSIONAL SECURITY INTELLIGENCE</Span>
                        </TextBlock>
                    </Border>

                    <!-- Prompt and Inputs -->
                    <StackPanel Grid.Row="1" Margin="0,5,0,0">
                        <TextBlock Text="Welcome! Please enter your name to initialize a personalized secure session:" FontSize="12.5" TextWrapping="Wrap" Foreground="#A0A0A0" TextAlignment="Center" Margin="0,0,0,12"/>
                        <Border Background="#121212" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <TextBox x:Name="TxtOnboardingName"
                                     Background="Transparent"
                                     Foreground="#FFFFFF"
                                     BorderThickness="0"
                                     CaretBrush="#00D2FF"
                                     FontSize="15"
                                     TextAlignment="Center"
                                     KeyDown="TxtOnboardingName_KeyDown"/>
                        </Border>
                    </StackPanel>

                    <!-- Action Button -->
                    <Button Grid.Row="2"
                            x:Name="BtnStartSession"
                            Content="START SECURE SESSION"
                            Style="{StaticResource PrimaryButton}"
                            Height="40"
                            Click="BtnStartSession_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
